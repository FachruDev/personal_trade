APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
BOT_CONTROL_TOKEN=replace-with-a-long-random-local-token
TRADING_ENVIRONMENT=paper

POSTGRES_DB=trading_bot
POSTGRES_USER=trading_bot
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trading_bot:replace-with-a-strong-local-password@postgres:5432/trading_bot

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

FREQTRADE_API_URL=http://freqtrade:8080
FREQTRADE_API_USERNAME=freqtrader
# Use a long ASCII-only password. Freqtrade cannot authenticate non-ASCII passwords.
FREQTRADE_API_PASSWORD=replace-with-a-long-ascii-only-password
FREQTRADE_JWT_SECRET=replace-with-a-long-random-jwt-secret
# Container path to the active risk profile. Keep paper-conservative until the
# release gates in docs/go-live-checklist.md have all been satisfied.
FREQTRADE_PROFILE_CONFIG=/freqtrade/user_data/config/profiles/paper-conservative.json
FREQTRADE_STRATEGY=LimitedRiskRegimeRiskStrategy
# Used only by a deliberately approved live deployment. Paper mode leaves this
# empty; Compose refuses live startup when the ignored approval record is absent.
LIVE_RELEASE_APPROVAL_FILE=

# Binance Spot: leave blank for public market data and dry-run
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PUBLIC_BASE_URL=https://api.binance.com

# Adapters are prepared; the MVP strategy does not call these providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=
AI_SHADOW_PROVIDER=disabled
AI_SHADOW_MIN_INTERVAL_SECONDS=900
# Set 0 to disable automatic public CoinGecko shadow snapshots.
GLOBAL_SHADOW_REFRESH_SECONDS=900
# Set 0 to disable public Binance order-book shadow snapshots. Metrics use the
# top 10 levels of a 20-level public depth response and never affect orders.
ORDERBOOK_SHADOW_REFRESH_SECONDS=300
# Four weeks at a five-minute collection cadence. The independent
# microstructure hypothesis cannot be evaluated before this sample is reached.
ORDERBOOK_SHADOW_MIN_OBSERVATIONS=8064
AUDIT_RETENTION_DAYS=180
CONTEXT_RETENTION_DAYS=365
NEWS_RETENTION_DAYS=30
AI_SHADOW_RETENTION_DAYS=365
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2
